# Copy this file to .env and adjust values

SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173

# Database — set USE_MONGODB=True to use MongoDB, or leave it False for SQLite.
# Start the local MongoDB service with `docker compose up -d mongo`.
USE_MONGODB=False
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_NAME=gharkobill

# PostgreSQL remains supported as an alternative relational database.
# Set these (and run `docker-compose up -d`) to use PostgreSQL instead.
# DB_NAME=gharkobill
# DB_USER=postgres
# DB_PASSWORD=postgrespassword
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Cloudinary (optional — leave unset to store uploaded files locally in /media)
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Celery & Redis (optional — only needed if you wire up background tasks)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
